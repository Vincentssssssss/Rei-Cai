# Copy to .env and fill in your values (do not commit .env)

# 阿里云百炼（原 DashScope 已迁移）
# 控制台：https://bailian.console.aliyun.com/
# 在百炼控制台复制完整的 OpenAI 兼容 Base URL（推荐）
OPENAI_API_KEY=your-bailian-api-key
OPENAI_BASE_URL=https://llm-your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=openai/qwen-plus

# 或只填业务空间前缀（llm- 开头，不是数字 ID）
# BAILIAN_WORKSPACE_ID=llm-your-workspace-id
# BAILIAN_REGION=cn-beijing

# OpenAI 官方（海外可用）
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
