# Copy to .env and fill in your values (do not commit .env)

# 阿里云百炼（原 DashScope 已迁移）
# 控制台：https://bailian.console.aliyun.com/
# 在「业务空间」页面获取 Workspace ID
OPENAI_API_KEY=your-bailian-api-key
BAILIAN_WORKSPACE_ID=your-workspace-id
BAILIAN_REGION=cn-beijing
OPENAI_MODEL=openai/qwen-plus

# 也可手动写完整地址（将 {WorkspaceId} 替换为业务空间 ID）
# OPENAI_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# OpenAI 官方（海外可用）
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
